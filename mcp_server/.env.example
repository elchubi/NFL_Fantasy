# ---- Required ----
# The league REST backend. Inside a shared Coolify network use the service
# name (e.g. http://sleeper-fantasy-api:8000); otherwise its public URL.
BACKEND_URL=http://sleeper-fantasy-api:8000

# The backend's API_KEY. Stays on the server side; Claude never sees it.
BACKEND_API_KEY=the-same-key-the-backend-uses

# The secret segment in the connector URL. This is the only thing protecting
# this server, so make it long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_URL_TOKEN=replace-with-a-long-random-token

# ---- Strongly recommended ----
# Public hostname(s), comma separated. The transport checks the Host header
# exactly (there is no wildcard), so an unlisted host is answered with 421.
# Leave empty and the check is disabled, with a warning at startup.
MCP_ALLOWED_HOSTS=mcp.tudominio.com

# ---- Optional ----
BACKEND_TIMEOUT=60
PORT=8080
LOG_LEVEL=INFO
