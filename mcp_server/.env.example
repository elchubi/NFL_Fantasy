# ---- Required ----
# The league REST backend. On Railway use the backend service's private domain:
#   http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
# Locally, the backend container or host.
BACKEND_URL=http://sleeper-fantasy-api:8000

# The backend's API_KEY. Stays on the server side; Claude never sees it.
BACKEND_API_KEY=the-same-key-the-backend-uses

# The secret segment in the connector URL. This is the only thing protecting
# this server, so make it long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_URL_TOKEN=replace-with-a-long-random-token

# ---- Strongly recommended ----
# Public hostname(s), comma separated. The transport checks the Host header
# exactly (there is no wildcard), so an unlisted host is answered with 421.
# Leave empty and the check is disabled, with a warning at startup.
MCP_ALLOWED_HOSTS=mcp.tudominio.com

# On Railway (and likely other platforms), the public-domain edge proxy could
# not reach this service bound to entrypoint.py's default `::` - the app came
# up cleanly but every request through the public URL answered 502
# "Application failed to respond". This is the one service in the repo with a
# public domain (the backend and public-data only talk over the private
# network, where `::` is required instead); confirmed on a live deploy that
# setting HOST fixes it immediately.
HOST=0.0.0.0

# ---- Optional ----
BACKEND_TIMEOUT=60
PORT=8080
LOG_LEVEL=INFO

# The backend can serve several leagues (its LEAGUES env var); every per-league
# tool takes a `league` slug argument. Set this to skip passing it on every
# call when this connector is used for one league day to day - leave it unset
# and the model is told to call league_list and pass one explicitly.
DEFAULT_LEAGUE=
