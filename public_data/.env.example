# ---- Required ----
# Shared secret required in X-API-Key on every endpoint but /health. Every
# league backend that talks to this service holds this same key as its own
# PUBLIC_DATA_API_KEY.
API_KEY=change-me-to-a-long-random-string

# ---- Optional ----
CACHE_DIR=/data
DATABASE_PATH=/data/public.db
PLAYERS_CACHE_PATH=/data/players_cache.json
PLAYERS_CACHE_TTL_HOURS=20

# Free key from https://the-odds-api.com. Shared across every league that
# uses this service - leave empty to disable /odds everywhere.
ODDS_API_KEY=
ODDS_CACHE_TTL_HOURS=24
ODDS_REGIONS=us
ODDS_BOOKMAKERS=

NFLVERSE_CACHE_TTL_HOURS=24
NFLVERSE_INCLUDE_RED_ZONE=true
NFLVERSE_DOWNLOAD_TIMEOUT=300

ESPN_CACHE_TTL_HOURS=3

WEATHER_CACHE_TTL_HOURS=12
WEATHER_GAMEDAY_CACHE_TTL_HOURS=1

HISTORY_AUTO_CAPTURE=true

HTTP_TIMEOUT=20
PLAYERS_HTTP_TIMEOUT=120
HTTP_MAX_RETRIES=3
CORS_ORIGINS=*
LOG_LEVEL=INFO
