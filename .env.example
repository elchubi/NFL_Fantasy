# ---- Required ----
# Sleeper league id (from the league URL: sleeper.com/leagues/<LEAGUE_ID>)
LEAGUE_ID=1390746710426255360
# Shared secret required in the X-API-Key header on every endpoint except /health
API_KEY=change-me-to-a-long-random-string

# The shared public-data service (see public_data/), reached over Railway's
# private network. Deploy that service once; every league backend points at
# the same instance. See public_data/.env.example for ITS variables (the
# provider/cache TTLs - ODDS_API_KEY, NFLVERSE_*, ESPN_*, WEATHER_* - live
# there now, not here.)
PUBLIC_DATA_URL=http://localhost:8100
PUBLIC_DATA_API_KEY=change-me-to-match-the-public-data-services-own-api-key

# On Railway these paths live on an attached Volume mounted at /data.
# ---- Optional ----
# Local player cache, hydrated from the public-data service rather than from
# Sleeper directly - still kept on disk so roster resolution stays a
# synchronous, in-memory lookup.
PLAYERS_CACHE_PATH=/data/players_cache.json
PLAYERS_CACHE_TTL_HOURS=20
# Directory for every other cache file (defaults to the player cache's directory)
CACHE_DIR=/data

# SQLite file holding THIS league's own history: transactions and draft picks
# across every season, roster snapshots, and the decision log. Betting lines
# and injury reports are archived by the public-data service instead, since
# they are not specific to this league. Defaults to <CACHE_DIR>/league.db.
DATABASE_PATH=/data/league.db
# Also archive whatever a read endpoint pulls fresh from upstream, on top of
# the scheduled /capture. Set false to archive only on /capture.
HISTORY_AUTO_CAPTURE=true

# ---- Optional: HTTP ----
HTTP_TIMEOUT=20
# Attempts per Sleeper call (exponential backoff on 429/5xx/timeouts)
HTTP_MAX_RETRIES=3
# Timeout for calls to the public-data service
PUBLIC_DATA_TIMEOUT=60
# Comma separated CORS origins ("*" = open, read-only API)
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ---- For `docker compose up` at the repo root only ----
# This file's docker-compose.yml brings up all three services together for
# local development (public-data, this backend, and its MCP connector). These
# variables belong to the other two services - see public_data/.env.example
# and mcp_server/.env.example for the full descriptions.
ODDS_API_KEY=
NFLVERSE_CACHE_TTL_HOURS=24
NFLVERSE_INCLUDE_RED_ZONE=true
ESPN_CACHE_TTL_HOURS=3
WEATHER_CACHE_TTL_HOURS=12
MCP_URL_TOKEN=replace-with-a-long-random-token
MCP_ALLOWED_HOSTS=
