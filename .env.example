# ---- Required ----
# Sleeper league id (from the league URL: sleeper.com/leagues/<LEAGUE_ID>)
LEAGUE_ID=1390746710426255360
# Shared secret required in the X-API-Key header on every endpoint except /health
API_KEY=change-me-to-a-long-random-string

# ---- Optional: Sleeper ----
# Where the ~5MB Sleeper player file is cached on disk
PLAYERS_CACHE_PATH=/data/players_cache.json
# Hours before the player cache is refreshed (Sleeper asks for <= 1 call/day)
PLAYERS_CACHE_TTL_HOURS=20
# Directory for every other source's cache file (defaults to the player cache's directory)
CACHE_DIR=/data

# ---- Optional: nflverse (advanced stats; free, no key) ----
NFLVERSE_CACHE_TTL_HOURS=24
# Red zone usage comes from the ~98MB play-by-play file. Set to false to skip
# that download and serve every other advanced stat.
NFLVERSE_INCLUDE_RED_ZONE=true
NFLVERSE_DOWNLOAD_TIMEOUT=300

# ---- Optional: The Odds API (betting lines) ----
# Free key from https://the-odds-api.com (~500 requests/month).
# Leave empty to disable /odds; every other endpoint keeps working.
ODDS_API_KEY=
ODDS_CACHE_TTL_HOURS=24
ODDS_REGIONS=us
# Restrict to specific books, e.g. draftkings,fanduel (empty = all in the region)
ODDS_BOOKMAKERS=

# ---- Optional: ESPN (injury reports; free, no key) ----
ESPN_CACHE_TTL_HOURS=3

# ---- Optional: Open-Meteo (weather; free, no key) ----
WEATHER_CACHE_TTL_HOURS=12
# Within a day of kickoff the forecast is refreshed this often instead
WEATHER_GAMEDAY_CACHE_TTL_HOURS=1

# ---- Optional: histórico / archive ----
# Append-only JSONL for the two sources that cannot be re-fetched later
# (betting lines and injury reports). Defaults to <CACHE_DIR>/history.
HISTORY_DIR=/data/history
# Also archive whatever a read endpoint pulls fresh from upstream, on top of
# the scheduled /capture. Set false to archive only on /capture.
HISTORY_AUTO_CAPTURE=true

# ---- Optional: HTTP ----
HTTP_TIMEOUT=20
PLAYERS_HTTP_TIMEOUT=120
# Attempts per upstream call (exponential backoff on 429/5xx/timeouts)
HTTP_MAX_RETRIES=3
# Comma separated CORS origins ("*" = open, read-only API)
CORS_ORIGINS=*
LOG_LEVEL=INFO
