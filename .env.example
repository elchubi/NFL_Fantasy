# ---- Required ----
# Sleeper league id (from the league URL: sleeper.com/leagues/<LEAGUE_ID>)
LEAGUE_ID=1390746710426255360
# Shared secret required in the X-API-Key header on every endpoint except /health
API_KEY=change-me-to-a-long-random-string

# ---- Optional ----
# Where the ~5MB Sleeper player file is cached on disk
PLAYERS_CACHE_PATH=/data/players_cache.json
# Hours before the player cache is refreshed (Sleeper asks for <= 1 call/day)
PLAYERS_CACHE_TTL_HOURS=20
# Per-request timeout (seconds) for calls to the Sleeper API
HTTP_TIMEOUT=20
# Longer timeout for the ~5MB /v1/players/nfl download
PLAYERS_HTTP_TIMEOUT=120
# Attempts per Sleeper call (exponential backoff on 429/5xx/timeouts)
HTTP_MAX_RETRIES=3
# Sleeper API base url
SLEEPER_BASE_URL=https://api.sleeper.app/v1
# Comma separated CORS origins ("*" = open, read-only API)
CORS_ORIGINS=*
LOG_LEVEL=INFO
